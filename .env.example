# Copy this file to .env and fill in all values before running locally.
# On Render, set these in the Environment tab of your web service.
# Never commit a real .env file.

# --- Database ---
# Render: use the Internal Connection String from your Postgres instance.
# Local dev: "postgresql://user:pass@localhost:5432/prop_desk" or "sqlite:///dev.db"
DATABASE_URL=postgresql://user:pass@localhost:5432/prop_desk

# --- Flask ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Required in production; the app refuses to start without it.
SECRET_KEY=replace-this-with-a-long-random-string

# "development" or "production"
FLASK_ENV=development

# --- Daily email report (optional) ---
# Gmail address the report is sent from and to, plus a Gmail app password.
REPORT_EMAIL=you@example.com
GMAIL_APP_PASSWORD=

# --- Seed users (run `flask seed-users` once from the Render shell) ---
# Comma-separated list of display names.
SEED_USERS=Jane Doe,John Doe

# Temporary password assigned to all seeded users. Must be changed on first login.
# Use a unique value and never commit the real one.
SEED_PASSWORD=choose-a-unique-temporary-password

# Optional one-time user creation from Render Environment settings.
# Enable only for the deployment that should create the account, then remove these values.
# BOOTSTRAP_USER_ENABLED=true
# BOOTSTRAP_USER_USERNAME=jane
# BOOTSTRAP_USER_DISPLAY_NAME=Jane Doe
# BOOTSTRAP_USER_EMAIL=jane@example.com
# BOOTSTRAP_USER_PASSWORD=choose-a-unique-temporary-password
